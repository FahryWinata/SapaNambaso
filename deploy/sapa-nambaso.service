[Unit]
Description=SAPA NAMBASO Web Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/sapaNambaso
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
ExecStart=/usr/bin/node /opt/sapaNambaso/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
